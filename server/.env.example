# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB connection string.
# Free Atlas cluster: https://www.mongodb.com/cloud/atlas/register (no credit card needed)
#   -> Database > Connect > Drivers, then paste the srv string below and swap in your DB user/password.
# Local instead: mongodb://127.0.0.1:27017/shelf
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shelf?retryWrites=true&w=majority

# Any long random string — used to sign/verify JWTs.
JWT_SECRET=replace-with-a-long-random-string

PORT=4000
